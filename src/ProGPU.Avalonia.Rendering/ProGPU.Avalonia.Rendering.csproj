<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <AssemblyName>Avalonia.ProGpu</AssemblyName>
    <RootNamespace>Avalonia.ProGpu</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <Avalonia_I_Want_To_Use_Private_Apis_IN_NUGET_PACKAGE>true</Avalonia_I_Want_To_Use_Private_Apis_IN_NUGET_PACKAGE>
    <Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>
    <PackageId>ProGPU.Avalonia.Rendering</PackageId>
    <Version>12.0.5-preview.27</Version>
    <PackageVersion>12.0.5-preview.27</PackageVersion>
    <Title>ProGPU rendering platform for Avalonia</Title>
    <Description>GPU-accelerated Avalonia rendering platform backed by ProGPU, Silk.NET, and WebGPU.</Description>
    <PackageTags>progpu;avalonia;rendering;webgpu;silk.net;gpu</PackageTags>
    <PackageIcon>ProGpuAvaloniaIcon.png</PackageIcon>
    <PackageReadmeFile>progpu-package-readme.md</PackageReadmeFile>
    <ProGpuAvaloniaSourceRoot Condition="'$(ProGpuAvaloniaSourceRoot)' != ''">$([MSBuild]::NormalizePath('$(ProGpuAvaloniaSourceRoot)'))</ProGpuAvaloniaSourceRoot>
    <DefineConstants Condition="'$(ProGpuAvaloniaSourceRoot)' != ''">$(DefineConstants);PROGPU_AVALONIA_SOURCE_COMPOSITOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
    <ProjectReference Include="..\ProGPU.Compute\ProGPU.Compute.csproj" />
    <ProjectReference Include="..\ProGPU.Scene\ProGPU.Scene.csproj" />
    <ProjectReference Include="..\ProGPU.Text\ProGPU.Text.csproj" />
    <ProjectReference Include="..\ProGPU.Vector\ProGPU.Vector.csproj" />
    <ProjectReference Include="..\SkiaSharp\SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuAvaloniaSourceRoot)' == ''">
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuAvaloniaSourceRoot)' != ''">
    <ProjectReference Include="$(ProGpuAvaloniaSourceRoot)\packages\Avalonia\Avalonia.csproj"
                      GlobalPropertiesToRemove="AvaloniaAccessUnstablePrivateApis;Avalonia_I_Want_To_Use_Private_Apis_IN_NUGET_PACKAGE;Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenFontSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="WebGPUSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\Assets\ProGpuAvaloniaIcon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\build\Assets\ProGpuAvaloniaIcon.svg" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\docs\progpu-package-readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Label="FriendAssemblies">
    <InternalsVisibleTo Include="Avalonia.ProGpu.UnitTests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="Avalonia.Skia.UnitTests, " />
  </ItemGroup>

  <Target Name="BindPinnedAvaloniaSourceAssemblies"
          AfterTargets="AddReferencePathsToRealAvaloniaAssemblies"
          Condition="'$(ProGpuAvaloniaSourceRoot)' != ''">
    <PropertyGroup>
      <PinnedAvaloniaOutput>$(ProGpuAvaloniaSourceRoot)\packages\Avalonia\bin\$(Configuration)\$(TargetFramework)</PinnedAvaloniaOutput>
    </PropertyGroup>
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="$([System.String]::Copy('%(Filename)').StartsWith('Avalonia'))" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="$([System.String]::Copy('%(Filename)').StartsWith('Avalonia'))" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)"
                                      Condition="$([System.String]::Copy('%(Filename)').StartsWith('Avalonia'))" />
      <PinnedAvaloniaAssembly Include="$(PinnedAvaloniaOutput)\Avalonia*.dll" />
      <Reference Include="@(PinnedAvaloniaAssembly)" />
      <ReferencePath Include="@(PinnedAvaloniaAssembly)" />
      <ReferencePathWithRefAssemblies Include="@(PinnedAvaloniaAssembly)" />
    </ItemGroup>
    <Error Condition="'@(PinnedAvaloniaAssembly)' == ''"
           Text="Pinned Avalonia assemblies were not found in $(PinnedAvaloniaOutput)." />
  </Target>
</Project>
