<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Platform-neutral WinRT-shaped value, storage, property-set, and media contracts shared by ProGPU framework adapters.</Description>
    <PackageDescription>Platform-neutral WinRT-shaped value, storage, property-set, and media contracts shared by ProGPU framework adapters.</PackageDescription>
    <PackageTags>progpu;winrt;contracts;storage;media;cross-platform</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProGPU.Media.Editing, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Tests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.WinUI, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
</Project>
