<Project>
  <PropertyGroup>
    <_ProGpuWgpuWindowsRuntimeRoot Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' != ''">$(ProGpuWgpuWindowsSourceRuntimeRoot)</_ProGpuWgpuWindowsRuntimeRoot>
    <_ProGpuWgpuWindowsRuntimeRoot Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)../runtimes</_ProGpuWgpuWindowsRuntimeRoot>
    <_ProGpuWgpuWindowsX64Available Condition="Exists('$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu-native-windows.json') And Exists('$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu_native.dll')">true</_ProGpuWgpuWindowsX64Available>
    <_ProGpuWgpuWindowsArm64Available Condition="Exists('$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu-native-windows.json') And Exists('$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu_native.dll')">true</_ProGpuWgpuWindowsArm64Available>
  </PropertyGroup>
  <!-- Source consumers stage only the eight default files; compiler DLLs never
       enter this payload. Package consumers use ordinary runtime assets. -->
  <ItemGroup Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' != '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(IsTestProject)' == 'true')">
    <Content Include="$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu_native.dll;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu-native-build.json;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/LICENSE.MIT;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/LICENSE.APACHE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu-LICENSE.MIT;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu-LICENSE.APACHE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/webgpu-headers-LICENSE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-x64/native/wgpu-native-windows.json"
             Condition="'$(_ProGpuWgpuWindowsX64Available)' == 'true' And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64')"
             Link="runtimes/win-x64/native/%(Filename)%(Extension)" ProGpuWgpuWindowsOwnedAsset="true" ProGpuWgpuWindowsRid="win-x64"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu_native.dll;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu-native-build.json;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/LICENSE.MIT;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/LICENSE.APACHE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu-LICENSE.MIT;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu-LICENSE.APACHE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/webgpu-headers-LICENSE;$(_ProGpuWgpuWindowsRuntimeRoot)/win-arm64/native/wgpu-native-windows.json"
             Condition="'$(_ProGpuWgpuWindowsArm64Available)' == 'true' And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-arm64')"
             Link="runtimes/win-arm64/native/%(Filename)%(Extension)" ProGpuWgpuWindowsOwnedAsset="true" ProGpuWgpuWindowsRid="win-arm64"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="ValidateProGpuWgpuWindowsSourceSelection" BeforeTargets="PrepareForBuild"
          Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' != '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(IsTestProject)' == 'true')">
    <Error Condition="('$(RuntimeIdentifier)' == 'win-x64' And '$(_ProGpuWgpuWindowsX64Available)' != 'true') Or ('$(RuntimeIdentifier)' == 'win-arm64' And '$(_ProGpuWgpuWindowsArm64Available)' != 'true')"
           Text="The selected owned Windows WebGPU source runtime is missing its DLL or receipt." />
  </Target>
  <!-- Replace exact Silk Windows runtime identities only. Other package/caller
       libraries and non-Windows assets remain independent. -->
  <Target Name="SelectProGpuWgpuWindowsBuildAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Silk.NET.WebGPU.Native.WGPU' And
            (('$(_ProGpuWgpuWindowsX64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)', '[/\\]runtimes[/\\]win-x64[/\\]native[/\\]wgpu_native\.dll$'))) Or
             ('$(_ProGpuWgpuWindowsArm64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)', '[/\\]runtimes[/\\]win-arm64[/\\]native[/\\]wgpu_native\.dll$'))))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Silk.NET.WebGPU.Native.WGPU' And
            (('$(_ProGpuWgpuWindowsX64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeTargetsCopyLocalItems.Identity)', '[/\\]runtimes[/\\]win-x64[/\\]native[/\\]wgpu_native\.dll$'))) Or
             ('$(_ProGpuWgpuWindowsArm64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeTargetsCopyLocalItems.Identity)', '[/\\]runtimes[/\\]win-arm64[/\\]native[/\\]wgpu_native\.dll$'))))" />
    </ItemGroup>
  </Target>
  <Target Name="SelectProGpuWgpuWindowsPublishAssets" AfterTargets="_ResolveCopyLocalAssetsForPublish">
    <ItemGroup>
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets)" Condition="'%(_ResolvedCopyLocalPublishAssets.NuGetPackageId)' == 'Silk.NET.WebGPU.Native.WGPU' And
            (('$(_ProGpuWgpuWindowsX64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(_ResolvedCopyLocalPublishAssets.Identity)', '[/\\]runtimes[/\\]win-x64[/\\]native[/\\]wgpu_native\.dll$'))) Or
             ('$(_ProGpuWgpuWindowsArm64Available)' == 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(_ResolvedCopyLocalPublishAssets.Identity)', '[/\\]runtimes[/\\]win-arm64[/\\]native[/\\]wgpu_native\.dll$'))))" />
    </ItemGroup>
  </Target>
</Project>
