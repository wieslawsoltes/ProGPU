<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <IsPackable>true</IsPackable>
    <PackageDescription>Typed zero-copy .NET host, native runtimes and C++20 headers with matching ProGPU.Native.Sdk archives for the isolated wgpu-native and provider-resolved Dawn renderers.</PackageDescription>
    <PackageTags>progpu;native;c++;webgpu;renderer;interop</PackageTags>
    <ProGpuNativeRuntimeRoot Condition="'$(ProGpuNativeRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\progpu-native\package</ProGpuNativeRuntimeRoot>
  </PropertyGroup>
  <!-- The staging artifact stays self-contained. These exact Windows files
       belong to the required ProGPU.Backend package, not a second native owner. -->
  <ItemGroup>
    <_ProGpuBackendOwnedWindowsRid Include="win-x64;win-arm64" />
    <_ProGpuBackendOwnedWindowsAsset Include="@(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\wgpu_native.dll');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\wgpu-native-build.json');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\LICENSE.MIT');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\LICENSE.APACHE');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\wgpu-LICENSE.MIT');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\wgpu-LICENSE.APACHE');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\webgpu-headers-LICENSE');
        @(_ProGpuBackendOwnedWindowsRid->'$(ProGpuNativeRuntimeRoot)\runtimes\%(Identity)\native\wgpu-native-windows.json')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Native.Sdk\ProGPU.Native.Sdk.csproj" Private="false" />
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProGPU.Tests, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <!-- NuGet already appends the relative glob path. A filename-shaped
         PackagePath misclassifies extensionless notices as directories. -->
    <None Include="$(ProGpuNativeRuntimeRoot)\**\*"
          Exclude="@(_ProGpuBackendOwnedWindowsAsset);$(ProGpuNativeRuntimeRoot)\runtimes\*\native\sdk\**\*"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="..\ProGPU.Native\include\*"
          Pack="true"
          PackagePath="build\native\include\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\ProGPU.Native\src\Compression\progpu_native_compression.cppm;
                   ..\ProGPU.Native\src\HitTesting\progpu_native_hit_testing.cppm;
                   ..\ProGPU.Native\src\Image\progpu_native_image.cppm;
                   ..\ProGPU.Native\src\Scene\Builder\progpu_native_scene_builder.cppm;
                   ..\ProGPU.Native\src\Text\progpu_native_text.cppm"
          Pack="true"
          PackagePath="build\native\modules\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\ProGPU.Native\cmake\ProGPUNativeConfig.cmake;..\ProGPU.Native\cmake\ProGPUNativeFontDependency.cmake;..\ProGPU.Native\cmake\ProGPUNativeEditWordDependency.cmake"
          Pack="true"
          PackagePath="build\native\cmake\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\..\eng\native-freetype.json" Pack="true"
          PackagePath="build\native\cmake\ProGPUNativeFontPin.json" Visible="false" />
    <None Include="..\..\eng\native-edit-word-icu.json" Pack="true"
          PackagePath="build\native\cmake\ProGPUNativeEditWordPin.json" Visible="false" />
  </ItemGroup>
  <Import Project="../../eng/ProGPU.Native.PackageValidation.targets" />
  <Import Project="../../eng/ProGPU.Native.SdkVersion.targets" />
</Project>
