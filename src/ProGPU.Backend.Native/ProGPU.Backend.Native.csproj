<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <IsPackable>true</IsPackable>
    <PackageDescription>Typed zero-copy .NET host plus standalone C++20 SDK for the isolated wgpu-native and provider-resolved Dawn ProGPU renderers.</PackageDescription>
    <PackageTags>progpu;native;c++;webgpu;renderer;interop</PackageTags>
    <ProGpuNativeRuntimeRoot Condition="'$(ProGpuNativeRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\progpu-native\package</ProGpuNativeRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProGPU.Tests, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(ProGpuNativeRuntimeRoot)\**\*"
          Pack="true"
          PackagePath="%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\ProGPU.Native\include\*"
          Pack="true"
          PackagePath="build\native\include\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\ProGPU.Native\src\Compression\progpu_native_compression.cppm;
                   ..\ProGPU.Native\src\HitTesting\progpu_native_hit_testing.cppm;
                   ..\ProGPU.Native\src\Image\progpu_native_image.cppm;
                   ..\ProGPU.Native\src\Scene\Builder\progpu_native_scene_builder.cppm;
                   ..\ProGPU.Native\src\Text\progpu_native_text.cppm"
          Pack="true"
          PackagePath="build\native\modules\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\ProGPU.Native\cmake\ProGPUNativeConfig.cmake;..\ProGPU.Native\cmake\ProGPUNativeFontDependency.cmake"
          Pack="true"
          PackagePath="build\native\cmake\%(Filename)%(Extension)"
          Visible="false" />
    <None Include="..\..\eng\native-freetype.json" Pack="true"
          PackagePath="build\native\cmake\ProGPUNativeFontPin.json" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateProGpuNativePackageRuntimes"
          BeforeTargets="Pack"
          Condition="'$(ProGpuNativeSkipRuntimeValidation)' != 'true'">
    <PropertyGroup>
      <_ProGpuFontRequiredArg Condition="'$(ProGpuNativeRequireFontHinting)' == 'true'">--require</_ProGpuFontRequiredArg>
      <ProGpuNativePython Condition="'$(ProGpuNativePython)' == '' and '$(OS)' == 'Windows_NT'">python</ProGpuNativePython>
      <ProGpuNativePython Condition="'$(ProGpuNativePython)' == ''">python3</ProGpuNativePython>
      <_ProGpuFontVerifier>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../eng/progpu-verify-freetype.py'))</_ProGpuFontVerifier>
      <_ProGpuFontRuntimeRoot>$([System.IO.Path]::GetFullPath('$(ProGpuNativeRuntimeRoot)'))</_ProGpuFontRuntimeRoot>
    </PropertyGroup>
    <ItemGroup>
      <_ProGpuFontAssets Include="$(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/progpu-native-font-dependency.json;
                                 $(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/*progpu_native_freetype*;
                                 $(ProGpuNativeRuntimeRoot)/runtimes/*/native/licenses/freetype/**/*" />
    </ItemGroup>
    <Exec Condition="'$(ProGpuNativeRequireFontHinting)' == 'true' or '@(_ProGpuFontAssets)' != ''"
          Command="&quot;$(ProGpuNativePython)&quot; &quot;$(_ProGpuFontVerifier)&quot; --package-root &quot;$(_ProGpuFontRuntimeRoot)&quot; $(_ProGpuFontRequiredArg)" />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-x64\native\libprogpu_native.so')"
           Text="The linux-x64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-arm64\native\libprogpu_native.so')"
           Text="The linux-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-x64\native\libprogpu_native.dylib')"
           Text="The osx-x64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-arm64\native\libprogpu_native.dylib')"
           Text="The osx-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native.dll')"
           Text="The win-x64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native.dll')"
           Text="The win-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-x64\native\libprogpu_native_dawn.so')"
           Text="The linux-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-arm64\native\libprogpu_native_dawn.so')"
           Text="The linux-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-x64\native\libprogpu_native_dawn.dylib')"
           Text="The osx-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-arm64\native\libprogpu_native_dawn.dylib')"
           Text="The osx-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native_dawn.dll')"
           Text="The win-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native_dawn.dll')"
           Text="The win-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native_direct2d.dll')"
           Text="The win-x64 ProGPU Direct2D COM provider has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native_direct2d.dll')"
           Text="The win-arm64 ProGPU Direct2D COM provider has not been staged." />
  </Target>
</Project>
