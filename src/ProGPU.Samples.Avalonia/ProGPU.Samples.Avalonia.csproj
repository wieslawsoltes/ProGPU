<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0-macos'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-macos'">Exe</OutputType>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-macos'">org.progpu.samples.avalonia</ApplicationId>
    <ApplicationTitle Condition="'$(TargetFramework)' == 'net10.0-macos'">ProGPU Avalonia Samples</ApplicationTitle>
    <TargetFrameworks>net10.0;net10.0-macos</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Native"
                      Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <PackageReference Include="Avalonia.Win32"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="ProDiagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Avalonia\ProGPU.Avalonia.csproj" />
    <ProjectReference Include="..\ProGPU.Avalonia.Rendering\ProGPU.Avalonia.Rendering.csproj" />
    <ProjectReference Include="..\ProGPU.Avalonia.SilkNet\ProGPU.Avalonia.SilkNet.csproj" />
    <ProjectReference Include="..\ProGPU.Samples\ProGPU.Samples.csproj" />
    <ProjectReference Include="..\ProGPU.Apple.Media\ProGPU.Apple.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <ProjectReference Include="..\ProGPU.Windows.Media\ProGPU.Windows.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\ProGPU.Linux.Media\ProGPU.Linux.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
