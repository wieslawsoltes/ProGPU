<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Portable Win2D-compatible Canvas API compiled to the ProGPU native C++ WebGPU renderer.</Description>
    <PackageDescription>Portable source-compatible Win2D Canvas device, bitmap, geometry, layer, render-target, and drawing-session API compiled to the retained ProGPU C++ WebGPU renderer.</PackageDescription>
    <PackageTags>progpu;win2d;direct2d;canvas;webgpu;native</PackageTags>
    <PackageReleaseNotes>Adds the first native C++ portable Canvas lane with BGRA8 premultiplied render targets, DPI conversion, transforms, solid primitives, default text, same-device bitmap drawing with opacity and typed GPU leases, retained command lists, path geometry, cached typed stroke styles, exact rectangle/geometry layer clips, target-preserving drawing sessions, diagnostics, and bounded D3D12/Metal/Vulkan validation.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Inter\ProGPU.Fonts.Inter.csproj" />
    <ProjectReference Include="..\ProGPU.Scene.Native\ProGPU.Scene.Native.csproj" />
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProGPU.Win2D.Tests, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
</Project>
