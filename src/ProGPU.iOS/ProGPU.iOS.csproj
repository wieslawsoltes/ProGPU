<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
    <ProGpuWgpuNativeXCFramework Condition="'$(ProGpuWgpuNativeXCFramework)' == ''">$(MSBuildThisFileDirectory)../../artifacts/wgpu-native-ios/wgpu_native.xcframework</ProGpuWgpuNativeXCFramework>
    <ProGpuDawnIOSXCFramework Condition="'$(ProGpuDawnIOSXCFramework)' == ''">$(MSBuildThisFileDirectory)../../artifacts/dawn-ios/webgpu_dawn.xcframework</ProGpuDawnIOSXCFramework>
    <ProGpuNativeDawnIOSXCFramework Condition="'$(ProGpuNativeDawnIOSXCFramework)' == ''">$(MSBuildThisFileDirectory)../../artifacts/progpu-native/mobile/ios/progpu_native_dawn.xcframework</ProGpuNativeDawnIOSXCFramework>
    <Description>Native UIKit and CAMetalLayer host, input, storage, and WebGPU/Metal integration for ProGPU applications.</Description>
    <PackageTags>progpu;ios;webgpu;metal;uikit;cametallayer;gpu;ui</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="..\ProGPU.Media\ProGPU.Media.csproj" />
    <ProjectReference Include="..\ProGPU.Apple.Media\ProGPU.Apple.Media.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI\ProGPU.WinUI.csproj" />
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Inter\ProGPU.Fonts.Inter.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Noto\ProGPU.Fonts.Noto.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuWgpuNativeXCFramework)')">
    <NativeReference Include="$(ProGpuWgpuNativeXCFramework)">
      <Kind>Framework</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>true</SmartLink>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuDawnIOSXCFramework)')">
    <NativeReference Include="$(ProGpuDawnIOSXCFramework)">
      <Kind>Framework</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <IsCxx>true</IsCxx>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuNativeDawnIOSXCFramework)')">
    <NativeReference Include="$(ProGpuNativeDawnIOSXCFramework)">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <IsCxx>true</IsCxx>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
    <None Include="$(ProGpuNativeDawnIOSXCFramework)\**\*"
          Pack="true"
          PackagePath="runtimes/ios/native/progpu_native_dawn.xcframework/%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
    <None Include="$(ProGpuNativeDawnIOSXCFramework)\..\BUILD-MANIFEST.txt"
          Pack="true"
          PackagePath="build/native/ios/BUILD-MANIFEST.txt"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/ProGPU.iOS.targets" Pack="true" PackagePath="buildTransitive/ProGPU.iOS.targets" />
  </ItemGroup>
  <Target Name="ProGpuWarnMissingWgpuNative" BeforeTargets="Build"
          Condition="!Exists('$(ProGpuWgpuNativeXCFramework)') and !Exists('$(ProGpuDawnIOSXCFramework)')">
    <Warning Text="ProGPU iOS compiled without a native WebGPU framework. Run eng/build-webgpu-dawn-ios.sh for zero-copy media, or eng/build-wgpu-native-ios.sh for the UI-only fallback." />
  </Target>
  <Target Name="ProGpuRequireIosZeroCopyMedia" BeforeTargets="Build"
          Condition="'$(ProGpuRequireZeroCopyMedia)' == 'true' and !Exists('$(ProGpuDawnIOSXCFramework)')">
    <Error Text="ProGpuRequireZeroCopyMedia=true requires the exact-ABI Dawn XCFramework. Run eng/build-webgpu-dawn-ios.sh." />
  </Target>
</Project>
