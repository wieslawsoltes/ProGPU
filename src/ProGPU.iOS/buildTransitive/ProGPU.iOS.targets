<Project>
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' And '$(ProGpuNativeDawnIOSXCFramework)' == ''">
    <ProGpuNativeDawnIOSXCFramework>$(MSBuildThisFileDirectory)..\runtimes\ios\native\progpu_native_dawn.xcframework</ProGpuNativeDawnIOSXCFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' And Exists('$(ProGpuNativeDawnIOSXCFramework)')">
    <NativeReference Include="$(ProGpuNativeDawnIOSXCFramework)">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <IsCxx>true</IsCxx>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' And '$(ProGpuWgpuNativeXCFramework)' != '' And Exists('$(ProGpuWgpuNativeXCFramework)')">
    <NativeReference Include="$(ProGpuWgpuNativeXCFramework)">
      <Kind>Framework</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>true</SmartLink>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' And '$(ProGpuDawnIOSXCFramework)' != '' And Exists('$(ProGpuDawnIOSXCFramework)')">
    <NativeReference Include="$(ProGpuDawnIOSXCFramework)">
      <Kind>Framework</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <IsCxx>true</IsCxx>
      <Frameworks>Metal</Frameworks>
    </NativeReference>
  </ItemGroup>
  <Target Name="ProGpuPackageWarnMissingIosWgpuNative"
          BeforeTargets="PrepareForBuild"
          Condition="'$(TargetPlatformIdentifier)' == 'ios' And ('$(ProGpuWgpuNativeXCFramework)' == '' Or !Exists('$(ProGpuWgpuNativeXCFramework)')) And ('$(ProGpuDawnIOSXCFramework)' == '' Or !Exists('$(ProGpuDawnIOSXCFramework)'))">
    <Warning Text="ProGPU.iOS requires a native WebGPU framework at deployment time. Run eng/build-webgpu-dawn-ios.sh for zero-copy media, or set ProGpuWgpuNativeXCFramework for the UI-only fallback." />
  </Target>
</Project>
