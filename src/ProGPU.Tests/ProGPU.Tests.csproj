<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
    <!-- Compatibility tests intentionally exercise official obsolete API contracts. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="WebGPUSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../tests/Shared/BinaryGlyphOriginals.json" LogicalName="BinaryGlyphOriginals.json" />
    <EmbeddedResource Include="../../tests/Shared/BinaryGlyphCurveOriginals.json" LogicalName="BinaryGlyphCurveOriginals.json" />
    <EmbeddedResource Include="TestData/SourceDeviceLines/metrics.json" LogicalName="SourceDeviceLines.metrics.json" />
    <EmbeddedResource Include="TestData/RasterCrossingReference/*.wgsl"
                      LogicalName="RasterCrossingReference.%(Filename)%(Extension)" />
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\ProGPU.SampleMemoryProfiler\DrawingTraceMethodRequirement.cs"
             Link="Diagnostics\DrawingTraceMethodRequirement.cs" />
    <Compile Include="..\..\tests\ProGPU.Native.PackageConsumer\NativeHintedPaintFailureReceipt.cs"
             Link="Diagnostics\NativeHintedPaintFailureReceipt.cs" />
    <Compile Include="..\ProGPU.Android\AndroidStorageNamePolicy.cs"
             Link="Android\AndroidStorageNamePolicy.cs" />
    <Compile Include="..\ProGPU.Android\AndroidScrollDeltaPolicy.cs"
             Link="Android\AndroidScrollDeltaPolicy.cs" />
    <Compile Include="..\ProGPU.Android\AndroidGpuDiagnosticSubscription.cs"
             Link="Android\AndroidGpuDiagnosticSubscription.cs" />
    <Compile Include="..\ProGPU.Android.Media\AndroidPcm16Mixer.cs"
             Link="Android\AndroidPcm16Mixer.cs" />
    <Compile Include="..\ProGPU.Android.Media\AndroidMediaCodecAudioPlanner.cs"
             Link="Android\AndroidMediaCodecAudioPlanner.cs" />
    <Compile Include="..\ProGPU.Android.Media\AndroidMediaCodecVideoEffectPlanner.cs"
             Link="Android\AndroidMediaCodecVideoEffectPlanner.cs" />
    <Compile Include="..\ProGPU.Android.Media\AndroidMediaCodecOverlayPlanner.cs"
             Link="Android\AndroidMediaCodecOverlayPlanner.cs" />
    <Compile Include="..\ProGPU.iOS\IosIndirectScrollPolicy.cs"
             Link="iOS\IosIndirectScrollPolicy.cs" />
    <ProjectReference Include="$(ProGpuWindowsBaseProject)" />
    <ProjectReference Include="$(ProGpuPresentationCoreProject)" />
    <ProjectReference Include="..\ProGPU.Avalonia\ProGPU.Avalonia.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="..\ProGPU.DirectX\ProGPU.DirectX.csproj" />
    <ProjectReference Include="..\ProGPU.Direct2D\ProGPU.Direct2D.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Inter\ProGPU.Fonts.Inter.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Noto\ProGPU.Fonts.Noto.csproj" />
    <ProjectReference Include="..\ProGPU.Media\ProGPU.Media.csproj" />
    <ProjectReference Include="..\ProGPU.Media.Editing\ProGPU.Media.Editing.csproj" />
    <ProjectReference Include="..\ProGPU.Media.Scene\ProGPU.Media.Scene.csproj" />
    <ProjectReference Include="..\ProGPU.Scene.Native\ProGPU.Scene.Native.csproj" />
    <ProjectReference Include="..\ProGPU.Windows.Media\ProGPU.Windows.Media.csproj">
      <Aliases>WindowsMediaProvider</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
    <ProjectReference Include="..\ProGPU.Linux.Media\ProGPU.Linux.Media.csproj" />
    <ProjectReference Include="..\ProGPU.Browser\ProGPU.Browser.csproj" />
    <ProjectReference Include="..\ProGPU.Tests.Headless\ProGPU.Tests.Headless.csproj" />
    <ProjectReference Include="..\ProGPU.Text.Shaping\ProGPU.Text.Shaping.csproj" />
    <ProjectReference Include="$(ProGpuWpfInteropProject)" />
    <ProjectReference Include="..\ProGPU.WinUI\ProGPU.WinUI.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI.Themes.Fluent\ProGPU.WinUI.Themes.Fluent.csproj" />
  </ItemGroup>
</Project>
