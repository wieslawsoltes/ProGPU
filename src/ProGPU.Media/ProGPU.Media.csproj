<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Typed, reflection-free ProGPU media playback, GPU frame lifetime, effects, audio processing, and provider contracts.</Description>
    <PackageTags>progpu;media;webgpu;video;audio;gpu;winui;avalonia</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProGPU.Android.Media, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Apple.Media, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Linux.Media, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Native.Benchmarks, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.WinUI, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Tests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Windows.Media, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
</Project>
