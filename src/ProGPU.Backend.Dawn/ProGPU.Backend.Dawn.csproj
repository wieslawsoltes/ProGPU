<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <PackageDescription>Typed Dawn WebGPU backend for ProGPU native presentation, shared texture memory, and cross-queue fences.</PackageDescription>
    <PackageTags>progpu;webgpu;dawn;gpu;presentation;shared-memory;iosurface;dxgi;vulkan</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WebGPUSharp" />
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="buildTransitive/ProGPU.Backend.Dawn.targets" Pack="true" PackagePath="buildTransitive/ProGPU.Backend.Dawn.targets" />
    <InternalsVisibleTo Include="Avalonia.ProGpu, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="Avalonia.ProGpu.UnitTests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Backend.Native, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.Tests, PublicKey=$(ProGPUPublicKey)" />
    <InternalsVisibleTo Include="ProGPU.DawnSystemWarp.Conformance, PublicKey=$(ProGPUPublicKey)" />
  </ItemGroup>
  <Import Project="../../eng/dawn-system-warp/packaging.targets" />
</Project>
