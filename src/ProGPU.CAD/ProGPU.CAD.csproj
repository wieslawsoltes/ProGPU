<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ACadSharp-backed DXF/DWG document sessions and the foundation for retained GPU-accelerated 2D/3D CAD rendering, editing, printing, and save workflows.</Description>
    <PackageDescription>ACadSharp-backed DXF/DWG document sessions and the foundation for retained GPU-accelerated 2D/3D CAD rendering, editing, printing, and save workflows.</PackageDescription>
    <PackageReleaseNotes>Introduces the ProGPU.CAD foundation and first immutable-scene/physical-output slice: pinned ACadSharp object model, typed DXF/DWG stream IO, generation-tagged WCS snapshots, bounded reversible transform/entity-property/layer-property/layer-add/entity-add-remove-duplicate edits, caller-buffered selection candidates with semantic root-handle deduplication, typed exact point and world-space Window/Crossing tests, an integrated exact-bounds query, shared plan-viewport mapping, desktop/browser click/drag selection overlays, finite-step multi-selection Move plus complete-selection-centered WCS-Z Rotate and uniform Scale with Undo/Redo, camera-preserving rebase compensation, transactional retained-picture replacement, and a bounded retained model-space print plan with physical paper/margins, plottable-layer filtering, fit/custom scale, center/offset placement, output-DPI lineweights, hierarchical spatial queries, large-coordinate rebasing, retained analytic geometry, bounded static block arrays, shaped TrueType TEXT, and bounded standard horizontal SHX TEXT parsing, caching, catalog/FMP resolution, ordered desktop discovery, and retained path recording.</PackageReleaseNotes>
    <PackageTags>progpu;cad;dxf;dwg;acadsharp;webgpu;rendering;editing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\ACadSharp\src\ACadSharp\ACadSharp.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      AdditionalProperties="TargetFrameworks=net10.0" />
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Scene\ProGPU.Scene.csproj" />
    <ProjectReference Include="..\ProGPU.Text\ProGPU.Text.csproj" />
    <ProjectReference Include="..\ProGPU.Vector\ProGPU.Vector.csproj" />
  </ItemGroup>
</Project>
