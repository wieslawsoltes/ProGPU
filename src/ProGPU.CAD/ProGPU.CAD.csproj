<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>ACadSharp-backed DXF/DWG document sessions and the foundation for retained GPU-accelerated 2D/3D CAD rendering, editing, printing, and save workflows.</Description>
    <PackageDescription>ACadSharp-backed DXF/DWG document sessions and the foundation for retained GPU-accelerated 2D/3D CAD rendering, editing, printing, and save workflows.</PackageDescription>
    <PackageReleaseNotes>Introduces the ProGPU.CAD foundation and first immutable-scene/physical-output slice: pinned ACadSharp object model, typed DXF/DWG stream IO, generation-tagged WCS snapshots, bounded reversible transform/entity-property/layer-property/layer-add/entity-add-remove-duplicate/attribute-value, persisted draw-order, named-page-setup creation/update/rename/deletion, and named-page-setup-to-layout edits, caller-buffered selection candidates with semantic root-handle deduplication, typed exact point and world-space Window/Crossing tests, an integrated exact-bounds query, shared plan-viewport mapping, desktop/browser click/drag selection overlays, finite-step multi-selection Move plus complete-selection-centered WCS-Z Rotate and uniform Scale with Undo/Redo, camera-preserving rebase compensation, transactional retained-picture replacement, bounded detached layout/named-page-setup extraction with explicit fidelity diagnostics, and a retained model-space print plan with physical paper/margins, all four page rotations, rotated-origin offsets, plottable-layer filtering, fit/current-custom scale, center/offset placement, output-DPI lineweights, hierarchical spatial queries, large-coordinate rebasing, retained analytic geometry, bounded static block arrays with variable/constant/hidden single-line or embedded-multiline attributes, shaped TrueType TEXT/MTEXT, bounded standard horizontal SHX TEXT/MTEXT parsing/layout/caching/catalog/FMP resolution, standalone DXF/DWG SHAPE identity/OCS/block-transform lowering through one cached retained path with exact selection and round-trip coverage, bounded analytic Normal solid HATCH polyline/line/circular-arc/elliptic-arc loops with odd-parity fill, exact signed-thickness SOLID/3DFACE surfaces, and modern level-zero or bounded crease-aware subdivided plus legacy MESH surfaces with semantic selection, managed depth replay, optional native replay, printing, and round-trip coverage.</PackageReleaseNotes>
    <PackageTags>progpu;cad;dxf;dwg;acadsharp;webgpu;rendering;editing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\ACadSharp\src\ACadSharp\ACadSharp.csproj"
                      SetTargetFramework="TargetFramework=net10.0"
                      AdditionalProperties="TargetFrameworks=net10.0" />
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Scene\ProGPU.Scene.csproj" />
    <ProjectReference Include="..\ProGPU.Text\ProGPU.Text.csproj" />
    <ProjectReference Include="..\ProGPU.Vector\ProGPU.Vector.csproj" />
  </ItemGroup>
</Project>
