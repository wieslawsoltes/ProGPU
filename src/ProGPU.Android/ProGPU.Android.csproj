<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
    <ProGpuWgpuNativeAndroidRoot Condition="'$(ProGpuWgpuNativeAndroidRoot)' == ''">$(MSBuildThisFileDirectory)../../artifacts/wgpu-native-android</ProGpuWgpuNativeAndroidRoot>
    <ProGpuDawnAndroidRoot Condition="'$(ProGpuDawnAndroidRoot)' == ''">$(MSBuildThisFileDirectory)../../artifacts/dawn-android</ProGpuDawnAndroidRoot>
    <ProGpuNativeDawnAndroidRoot Condition="'$(ProGpuNativeDawnAndroidRoot)' == ''">$(MSBuildThisFileDirectory)../../artifacts/progpu-native/mobile/android</ProGpuNativeDawnAndroidRoot>
    <Description>Native Android SurfaceView host, input, storage, and WebGPU/Vulkan integration for ProGPU applications.</Description>
    <PackageTags>progpu;android;webgpu;vulkan;surfaceview;gpu;ui</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI\ProGPU.WinUI.csproj" />
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Inter\ProGPU.Fonts.Inter.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Noto\ProGPU.Fonts.Noto.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuWgpuNativeAndroidRoot)')">
    <AndroidNativeLibrary Include="$(ProGpuWgpuNativeAndroidRoot)\**\libwgpu_native.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuDawnAndroidRoot)')">
    <AndroidNativeLibrary Include="$(ProGpuDawnAndroidRoot)\**\libwebgpu_dawn.so" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ProGpuNativeDawnAndroidRoot)')">
    <AndroidNativeLibrary Include="$(ProGpuNativeDawnAndroidRoot)\**\libprogpu_native_dawn.so" />
    <None Include="$(ProGpuNativeDawnAndroidRoot)\lib\arm64-v8a\libprogpu_native_dawn.so"
          Pack="true"
          PackagePath="runtimes/android-arm64/native/libprogpu_native_dawn.so"
          Visible="false" />
    <None Include="$(ProGpuNativeDawnAndroidRoot)\lib\x86_64\libprogpu_native_dawn.so"
          Pack="true"
          PackagePath="runtimes/android-x64/native/libprogpu_native_dawn.so"
          Visible="false" />
    <None Include="$(ProGpuNativeDawnAndroidRoot)\BUILD-MANIFEST.txt"
          Pack="true"
          PackagePath="build/native/android/BUILD-MANIFEST.txt"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/ProGPU.Android.targets" Pack="true" PackagePath="buildTransitive/ProGPU.Android.targets" />
  </ItemGroup>
  <Target Name="ProGpuWarnMissingAndroidWgpuNative" BeforeTargets="Build"
          Condition="!Exists('$(ProGpuWgpuNativeAndroidRoot)/lib/arm64-v8a/libwgpu_native.so') and !Exists('$(ProGpuWgpuNativeAndroidRoot)/lib/x86_64/libwgpu_native.so') and !Exists('$(ProGpuDawnAndroidRoot)/lib/arm64-v8a/libwebgpu_dawn.so') and !Exists('$(ProGpuDawnAndroidRoot)/lib/x86_64/libwebgpu_dawn.so')">
    <Warning Text="ProGPU Android compiled without a native WebGPU library. Run eng/build-webgpu-dawn-android.sh for exact-ABI zero-copy media, or eng/build-wgpu-native-android.sh for the UI-only fallback." />
  </Target>
  <Target Name="ProGpuRequireAndroidZeroCopyMedia" BeforeTargets="Build"
          Condition="'$(ProGpuRequireZeroCopyMedia)' == 'true' and !Exists('$(ProGpuDawnAndroidRoot)/lib/arm64-v8a/libwebgpu_dawn.so') and !Exists('$(ProGpuDawnAndroidRoot)/lib/x86_64/libwebgpu_dawn.so')">
    <Error Text="ProGpuRequireZeroCopyMedia=true requires an exact-ABI Dawn package. Run eng/build-webgpu-dawn-android.sh for the requested Android ABI." />
  </Target>
</Project>
