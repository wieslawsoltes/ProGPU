<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-macos</TargetFrameworks>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-macos'">org.progpu.cad.sample</ApplicationId>
    <ApplicationTitle Condition="'$(TargetFramework)' == 'net10.0-macos'">ProGPU.CAD</ApplicationTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>..\ProGPU.Samples.Desktop\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProGPU.CAD.Sample\ProGPU.CAD.Sample.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
    <ProjectReference Include="..\ProGPU.Apple.Media\ProGPU.Apple.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <ProjectReference Include="..\ProGPU.Windows.Media\ProGPU.Windows.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\ProGPU.Linux.Media\ProGPU.Linux.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
