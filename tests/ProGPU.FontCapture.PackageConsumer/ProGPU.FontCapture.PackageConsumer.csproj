<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreSources Condition="'$(ProGpuNativePackageSource)' != ''">$(ProGpuNativePackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' != 'true'">
    <PackageReference Include="ProGPU.Scene.Native" VersionOverride="$(ProGpuNativePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' == 'true'">
    <ProjectReference Include="../../src/ProGPU.Scene.Native/ProGPU.Scene.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Shared/ProGPU-Authored-Scan-1.ttf" LogicalName="ProGPU-Authored-Scan-1.ttf" />
    <EmbeddedResource Include="../Shared/ProGPU-Authored-Curve-Scan-1.ttf" LogicalName="ProGPU-Authored-Curve-Scan-1.ttf" />
  </ItemGroup>
</Project>
