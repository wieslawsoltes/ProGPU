    <Compile Include="../../src/ProGPU.Tests/SinglePathRasterPipelineTests.cs" Link="SinglePathRasterPipelineTests.cs" />
    <Compile Include="../../src/ProGPU.Tests/RasterCrossingGlyphTests.cs" Link="RasterCrossingGlyphTests.cs" />
    <EmbeddedResource Include="../../src/ProGPU.Tests/TestData/RasterCrossingReference/*.wgsl"
                      LogicalName="RasterCrossingReference.%(Filename)%(Extension)" />
    <Compile Include="../../src/ProGPU.Tests/LinearPathRasterPipelineTests.cs" Link="LinearPathRasterPipelineTests.cs" />
    <Compile Include="../../src/ProGPU.Tests/LinearWindingRasterPipelineTests.cs" Link="LinearWindingRasterPipelineTests.cs" />
    <Compile Include="../../src/ProGPU.Tests/VerticalPathCrossingTests.cs" Link="VerticalPathCrossingTests.cs" />
    <Compile Include="../../src/ProGPU.Tests/CubicPathRasterPipelineTests.cs" Link="CubicPathRasterPipelineTests.cs" />
  </ItemGroup>
</Project>
