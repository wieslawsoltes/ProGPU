<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);AVALONIA11</DefineConstants>
    <AssemblyName>ProGPU.Avalonia.SilkNet.ContractTests</AssemblyName>
    <RootNamespace>ProGPU.Avalonia.SilkNet.ContractTests</RootNamespace>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <Avalonia_I_Want_To_Use_Private_Apis_IN_NUGET_PACKAGE>true</Avalonia_I_Want_To_Use_Private_Apis_IN_NUGET_PACKAGE>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ProGPU.Avalonia.SilkNet.ContractTests\*.cs"
             Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" VersionOverride="11.3.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\..\src\ProGPU.Avalonia.SilkNet.V11\ProGPU.Avalonia.SilkNet.V11.csproj" />
  </ItemGroup>
</Project>
