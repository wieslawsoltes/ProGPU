<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RestoreSources Condition="'$(ProGpuDawnUsePackage)' == 'true'">$(ProGpuDawnPackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
    <ProGpuEnableDawnSystemWarp Condition="'$(ProGpuDawnUsePackage)' == 'true'">true</ProGpuEnableDawnSystemWarp>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuDawnUsePackage)' != 'true'">
    <ProjectReference Include="../../src/ProGPU.Backend.Dawn/ProGPU.Backend.Dawn.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuDawnUsePackage)' == 'true'">
    <PackageReference Include="ProGPU.Backend.Dawn" VersionOverride="$(ProGpuDawnPackageVersion)" />
  </ItemGroup>
</Project>
