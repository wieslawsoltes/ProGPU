<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Only the explicit Windows Dawn fixture opts into the optional payload.
         Keep ordinary/default/stock and non-Windows consumers unchanged. -->
    <RuntimeIdentifier Condition="'$(ProGpuDawnSystemWarpTestRid)' != ''">$(ProGpuDawnSystemWarpTestRid)</RuntimeIdentifier>
    <ProGpuEnableDawnSystemWarp Condition="'$(ProGpuDawnSystemWarpTestRid)' != ''">true</ProGpuEnableDawnSystemWarp>
    <RestoreSources>$(ProGpuNativePackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' != 'true'">
    <PackageReference Include="ProGPU.Backend.Native" VersionOverride="$(ProGpuNativePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuUseDx12Runtime)' == 'true'">
    <PackageReference Include="ProGPU.Backend.Dx12" VersionOverride="$(ProGpuNativePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' == 'true'">
    <ProjectReference Include="..\..\src\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\ProGPU.Fonts.Inter\Fonts\Inter-Regular.ttf"
          Link="Inter-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\src\ProGPU.Fonts.Inter\Fonts\InterVariable.ttf"
          Link="InterVariable.ttf"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
