<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreSources>$(ProGpuNativePackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' != 'true'">
    <PackageReference Include="ProGPU.Backend.Native" VersionOverride="$(ProGpuNativePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuNativeUseProjectReference)' == 'true'">
    <ProjectReference Include="..\..\src\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\ProGPU.Fonts.Inter\Fonts\Inter-Regular.ttf"
          Link="Inter-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
