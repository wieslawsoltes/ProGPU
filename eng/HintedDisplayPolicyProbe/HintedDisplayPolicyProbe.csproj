<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(ProGpuRuntimePackageVersion)' == ''">
    <ProjectReference Include="../../src/ProGPU.Backend.Native/ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="../../src/ProGPU.Text/ProGPU.Text.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuRuntimePackageVersion)' != ''">
    <PackageVersion Include="ProGPU.Backend.Native" Version="$(ProGpuRuntimePackageVersion)" />
    <PackageVersion Include="ProGPU.Text" Version="$(ProGpuRuntimePackageVersion)" />
    <PackageReference Include="ProGPU.Backend.Native" />
    <PackageReference Include="ProGPU.Text" />
  </ItemGroup>
</Project>
