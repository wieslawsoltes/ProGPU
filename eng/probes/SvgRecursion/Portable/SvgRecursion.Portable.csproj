<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SvgSourceRoot Condition="'$(SvgSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\external\Svg.Skia\externals\SVG</SvgSourceRoot>
    <ProGpuSourceRoot>$(MSBuildThisFileDirectory)..\..\..\..</ProGpuSourceRoot>
    <UseProGpuSystemDrawing>true</UseProGpuSystemDrawing>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <ProjectReference Include="$(SvgSourceRoot)/Source/Svg.csproj"
                      AdditionalProperties="ManagePackageVersionsCentrally=false;UseProGpuSystemDrawing=true" />
    <ProjectReference Include="$(ProGpuSourceRoot)/src/System.Drawing.Common/System.Drawing.Common.csproj" />
  </ItemGroup>
</Project>
