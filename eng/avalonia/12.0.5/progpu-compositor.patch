+/// <summary>
+/// Identifies an immutable byte range within an assembly manifest resource.
+/// Consumers that understand this typed contract can borrow the mapped resource
+/// directly; ordinary stream consumers retain the existing sliced-stream behavior.
+/// </summary>
+internal sealed class AssemblyResourceSliceStream : SlicedStream
+{
+    private readonly Assembly _assembly;
+
+    public AssemblyResourceSliceStream(
+        Stream baseStream,
+        Assembly assembly,
+        string resourceName,
+        int from,
+        int length)
+        : base(baseStream, from, length)
+    {
+        _assembly = assembly;
+        ResourceName = resourceName;
+        ResourceOffset = from;
+        ResourceLength = length;
+    }
+
+    public string ResourceName { get; }
+    public int ResourceOffset { get; }
+    public int ResourceLength { get; }
+
+    public Stream OpenResourceStream() =>
+        _assembly.GetManifestResourceStream(ResourceName) ??
+        throw new InvalidOperationException(
+            $"Could not find manifest resource stream '{ResourceName}'.");
+}
