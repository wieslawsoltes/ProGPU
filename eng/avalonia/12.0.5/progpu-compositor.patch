@@ -0,0 +1,83 @@
+using Avalonia.Media;
+using Avalonia.Media.Immutable;
+using Avalonia.Rendering;
+using Avalonia.Rendering.Composition;
+using Avalonia.Rendering.Composition.Drawing;
+using Avalonia.Rendering.Composition.Server;
+using Avalonia.UnitTests;
+using Xunit;
+
+namespace Avalonia.Base.UnitTests.Composition;
+
+public class RetainedCompositionRevisionTests : ScopedTestBase
+{
+    [Fact]
+    public void DrawListContentRevisionIsIndependentFromVisualStateRevision()
+    {
+        using var app = UnitTestApplication.Start(TestServices.StyledWindow);
+        var compositor = new Compositor(
+            RenderLoop.FromTimer(new CompositorTestServices.ManualRenderTimer()),
+            null);
+        var visual = new CompositionDrawListVisual(
+            compositor,
+            new ServerCompositionDrawListVisual(compositor.Server, null!),
+            null!);
+
+        visual.DrawList = CreateDrawList(compositor, Colors.Red);
+        CommitAndRender(compositor);
+
+        var server = (ServerCompositionDrawListVisual)visual.Server;
+        ulong initialStateRevision = server.RetainedRevision;
+        ulong initialContentRevision = server.RetainedContentRevision;
+
+        visual.Offset = new Vector3D(8, 4, 0);
+        CommitAndRender(compositor);
+
+        Assert.NotEqual(initialStateRevision, server.RetainedRevision);
+        Assert.Equal(initialContentRevision, server.RetainedContentRevision);
+
+        visual.DrawList = CreateDrawList(compositor, Colors.Blue);
+        CommitAndRender(compositor);
+
+        Assert.NotEqual(initialContentRevision, server.RetainedContentRevision);
+    }
+
+    [Fact]
+    public void ParentChangeDelayedFlagsAreConsumedByOneRecompute()
+    {
+        using var app = UnitTestApplication.Start(TestServices.StyledWindow);
+        var compositor = new Compositor(
+            RenderLoop.FromTimer(new CompositorTestServices.ManualRenderTimer()),
+            null);
+        var parent = compositor.CreateContainerVisual();
+        var child = compositor.CreateContainerVisual();
+
+        parent.Children.InsertAtTop(child);
+        CommitAndRender(compositor);
+
+        var server = (ServerCompositionVisual)child.Server;
+        ulong revision = server.RetainedRevision;
+
+        server.RecomputeOwnProperties();
+
+        Assert.Equal(revision, server.RetainedRevision);
+    }
+
+    private static CompositionRenderData CreateDrawList(
+        Compositor compositor,
+        Color color)
+    {
+        var context = new RenderDataDrawingContext(compositor);
+        context.DrawRectangle(
+            new ImmutableSolidColorBrush(color),
+            null,
+            new Rect(new Size(20, 10)));
+        return context.GetRenderResults()!;
+    }
+
+    private static void CommitAndRender(Compositor compositor)
+    {
+        compositor.Commit();
+        compositor.Server.Render(false);
+    }
+}
