@@ -0,0 +1,39 @@
+using Avalonia.Platform;
+using Avalonia.Rendering;
+using Avalonia.UnitTests;
+using Moq;
+using Xunit;
+
+namespace Avalonia.Base.UnitTests.Rendering;
+
+public class PlatformRenderInterfaceContextManagerTests
+{
+    [Fact]
+    public void Lost_Backend_Context_Is_Disposed_And_Recreated_Without_Platform_Graphics()
+    {
+        var firstIsLost = false;
+        var firstContext = new Mock<IPlatformRenderInterfaceContext>();
+        firstContext.SetupGet(context => context.IsLost)
+            .Returns(() => firstIsLost);
+
+        var secondContext = new Mock<IPlatformRenderInterfaceContext>();
+        var renderInterface = new Mock<IPlatformRenderInterface>();
+        renderInterface.SetupSequence(renderer => renderer.CreateBackendContext(null))
+            .Returns(firstContext.Object)
+            .Returns(secondContext.Object);
+
+        using var application = UnitTestApplication.Start(
+            new TestServices(renderInterface: renderInterface.Object));
+        var manager = new PlatformRenderInterfaceContextManager(graphics: null);
+
+        Assert.Same(firstContext.Object, manager.Value);
+
+        firstIsLost = true;
+
+        Assert.Same(secondContext.Object, manager.Value);
+        firstContext.Verify(context => context.Dispose(), Times.Once);
+        renderInterface.Verify(
+            renderer => renderer.CreateBackendContext(null),
+            Times.Exactly(2));
+    }
+}
