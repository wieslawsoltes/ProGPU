+using Avalonia.Platform;
+
+namespace Avalonia.Rendering.Composition.Server;
+
+/// <summary>
+/// Optional typed bridge for drawing contexts that own a retained visual scene.
+/// Implementations return false when the current tree contains a composition
+/// feature that requires Avalonia's built-in traversal.
+/// </summary>
+internal interface ICompositionVisualTreeDrawingContextFeature
+{
+    bool TryRender(
+        ServerCompositionTarget target,
+        ServerCompositionVisual root,
+        LtrbRect clip,
+        out int visitedVisuals,
+        out int renderedVisuals);
+}
