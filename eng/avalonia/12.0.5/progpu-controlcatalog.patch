@@ -111,6 +113,23 @@ protected override void OnAttachedToVisualTree(VisualTreeAttachmentEventArgs e)
                     ViewModel.IsSystemBarVisible = insets.IsSystemBarVisible ?? true;
                 };
             }
+
+        }
+
+        private void SelectInitialPage(string initialPage)
+        {
+            for (var i = 0; i < Sidebar.ItemsView.Count; i++)
+            {
+                if (string.Equals(
+                        (Sidebar.ItemsView[i] as TabItem)?.Header?.ToString(),
+                        initialPage,
+                        StringComparison.OrdinalIgnoreCase))
+                {
+                    Sidebar.SelectedIndex = i;
+                    Console.WriteLine($"[ControlCatalog] selected page={initialPage} index={i}");
+                    return;
+                }
+            }
         }
     }
 }
