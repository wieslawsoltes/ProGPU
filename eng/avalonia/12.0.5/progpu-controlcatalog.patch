@@ -0,0 +1,172 @@
+using System;
+using Avalonia;
+using Avalonia.Controls;
+using ControlCatalog.Pages;
+
+namespace ControlCatalog;
+
+internal sealed class DeferredCatalogPage : ContentControl
+{
+    private bool _pageCreated;
+
+    public CatalogPageKind PageKind { get; set; }
+
+    protected override void OnAttachedToVisualTree(VisualTreeAttachmentEventArgs e)
+    {
+        base.OnAttachedToVisualTree(e);
+
+        if (!_pageCreated)
+        {
+            Content = CreatePage(PageKind);
+            _pageCreated = true;
+        }
+    }
+
+    private static Control CreatePage(CatalogPageKind pageKind) =>
+        pageKind switch
+        {
+            CatalogPageKind.AcceleratorPage => new AcceleratorPage(),
+            CatalogPageKind.AcrylicPage => new AcrylicPage(),
+            CatalogPageKind.AdornerLayerPage => new AdornerLayerPage(),
+            CatalogPageKind.AutoCompleteBoxPage => new AutoCompleteBoxPage(),
+            CatalogPageKind.BitmapCachePage => new BitmapCachePage(),
+            CatalogPageKind.BorderPage => new BorderPage(),
+            CatalogPageKind.ButtonSpinnerPage => new ButtonSpinnerPage(),
+            CatalogPageKind.ButtonsPage => new ButtonsPage(),
+            CatalogPageKind.CalendarDatePickerPage => new CalendarDatePickerPage(),
+            CatalogPageKind.CalendarPage => new CalendarPage(),
+            CatalogPageKind.CanvasPage => new CanvasPage(),
+            CatalogPageKind.CarouselDemoPage => new CarouselDemoPage(),
+            CatalogPageKind.CheckBoxPage => new CheckBoxPage(),
+            CatalogPageKind.ClipboardPage => new ClipboardPage(),
+            CatalogPageKind.ColorPickerPage => new ColorPickerPage(),
+            CatalogPageKind.ComboBoxPage => new ComboBoxPage(),
+            CatalogPageKind.CommandBarPage => new CommandBarPage(),
+            CatalogPageKind.CompositionPage => new CompositionPage(),
+            CatalogPageKind.ContainerQueryPage => new ContainerQueryPage(),
+            CatalogPageKind.ContentDemoPage => new ContentDemoPage(),
+            CatalogPageKind.ContextFlyoutPage => new ContextFlyoutPage(),
+            CatalogPageKind.ContextMenuPage => new ContextMenuPage(),
+            CatalogPageKind.CursorPage => new CursorPage(),
+            CatalogPageKind.CustomDrawing => new CustomDrawing(),
+            CatalogPageKind.DataGridPage => new DataGridPage(),
+            CatalogPageKind.DataValidationPage => new DataValidationPage(),
+            CatalogPageKind.DateTimePickerPage => new DateTimePickerPage(),
+            CatalogPageKind.DialogsPage => new DialogsPage(),
+            CatalogPageKind.DragAndDropPage => new DragAndDropPage(),
+            CatalogPageKind.DrawerDemoPage => new DrawerDemoPage(),
+            CatalogPageKind.ExpanderPage => new ExpanderPage(),
+            CatalogPageKind.FlyoutsPage => new FlyoutsPage(),
+            CatalogPageKind.FocusPage => new FocusPage(),
+            CatalogPageKind.GesturePage => new GesturePage(),
+            CatalogPageKind.HeaderedContentPage => new HeaderedContentPage(),
+            CatalogPageKind.ImagePage => new ImagePage(),
+            CatalogPageKind.LabelsPage => new LabelsPage(),
+            CatalogPageKind.LayoutTransformControlPage => new LayoutTransformControlPage(),
+            CatalogPageKind.ListBoxPage => new ListBoxPage(),
+            CatalogPageKind.MenuPage => new MenuPage(),
+            CatalogPageKind.NativeEmbedPage => new NativeEmbedPage(),
+            CatalogPageKind.NavigationDemoPage => new NavigationDemoPage(),
+            CatalogPageKind.NotificationsPage => new NotificationsPage(),
+            CatalogPageKind.NumericUpDownPage => new NumericUpDownPage(),
+            CatalogPageKind.OpenGlLeasePage => new OpenGlLeasePage(),
+            CatalogPageKind.OpenGlPage => new OpenGlPage(),
+            CatalogPageKind.PipsPagerPage => new PipsPagerPage(),
+            CatalogPageKind.PlatformInfoPage => new PlatformInfoPage(),
+            CatalogPageKind.PointersPage => new PointersPage(),
+            CatalogPageKind.ProgressBarPage => new ProgressBarPage(),
+            CatalogPageKind.RadioButtonPage => new RadioButtonPage(),
+            CatalogPageKind.RefreshContainerPage => new RefreshContainerPage(),
+            CatalogPageKind.RelativePanelPage => new RelativePanelPage(),
+            CatalogPageKind.ScreenPage => new ScreenPage(),
+            CatalogPageKind.ScrollViewerPage => new ScrollViewerPage(),
+            CatalogPageKind.SliderPage => new SliderPage(),
+            CatalogPageKind.SplitViewPage => new SplitViewPage(),
+            CatalogPageKind.TabControlPage => new TabControlPage(),
+            CatalogPageKind.TabStripPage => new TabStripPage(),
+            CatalogPageKind.TabbedDemoPage => new TabbedDemoPage(),
+            CatalogPageKind.TextBlockPage => new TextBlockPage(),
+            CatalogPageKind.TextBoxPage => new TextBoxPage(),
+            CatalogPageKind.ThemePage => new ThemePage(),
+            CatalogPageKind.ToggleSwitchPage => new ToggleSwitchPage(),
+            CatalogPageKind.ToolTipPage => new ToolTipPage(),
+            CatalogPageKind.TransitioningContentControlPage => new TransitioningContentControlPage(),
+            CatalogPageKind.TreeViewPage => new TreeViewPage(),
+            CatalogPageKind.ViewboxPage => new ViewboxPage(),
+            CatalogPageKind.WindowCustomizationsPage => new WindowCustomizationsPage(),
+            _ => throw new ArgumentOutOfRangeException(nameof(pageKind), pageKind, null)
+        };
+}
+
+internal enum CatalogPageKind
+{
+    AcceleratorPage,
+    AcrylicPage,
+    AdornerLayerPage,
+    AutoCompleteBoxPage,
+    BitmapCachePage,
+    BorderPage,
+    ButtonSpinnerPage,
+    ButtonsPage,
+    CalendarDatePickerPage,
+    CalendarPage,
+    CanvasPage,
+    CarouselDemoPage,
+    CheckBoxPage,
+    ClipboardPage,
+    ColorPickerPage,
+    ComboBoxPage,
+    CommandBarPage,
+    CompositionPage,
+    ContainerQueryPage,
+    ContentDemoPage,
+    ContextFlyoutPage,
+    ContextMenuPage,
+    CursorPage,
+    CustomDrawing,
+    DataGridPage,
+    DataValidationPage,
+    DateTimePickerPage,
+    DialogsPage,
+    DragAndDropPage,
+    DrawerDemoPage,
+    ExpanderPage,
+    FlyoutsPage,
+    FocusPage,
+    GesturePage,
+    HeaderedContentPage,
+    ImagePage,
+    LabelsPage,
+    LayoutTransformControlPage,
+    ListBoxPage,
+    MenuPage,
+    NativeEmbedPage,
+    NavigationDemoPage,
+    NotificationsPage,
+    NumericUpDownPage,
+    OpenGlLeasePage,
+    OpenGlPage,
+    PipsPagerPage,
+    PlatformInfoPage,
+    PointersPage,
+    ProgressBarPage,
+    RadioButtonPage,
+    RefreshContainerPage,
+    RelativePanelPage,
+    ScreenPage,
+    ScrollViewerPage,
+    SliderPage,
+    SplitViewPage,
+    TabControlPage,
+    TabStripPage,
+    TabbedDemoPage,
+    TextBlockPage,
+    TextBoxPage,
+    ThemePage,
+    ToggleSwitchPage,
+    ToolTipPage,
+    TransitioningContentControlPage,
