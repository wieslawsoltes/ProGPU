+void D3D12HelloTexture::WriteCapture()
+{
+    const UINT64 captureBytes = static_cast<UINT64>(
+        m_captureFootprint.Footprint.RowPitch) * m_height;
+    const CD3DX12_RANGE readRange(0, static_cast<SIZE_T>(captureBytes));
+    void* mapped = nullptr;
+    ThrowIfFailed(m_captureReadback->Map(0, &readRange, &mapped));
+    const UINT8* pixels = static_cast<const UINT8*>(mapped);
+
+    FILE* output = nullptr;
+    if (_wfopen_s(&output, m_capturePath.c_str(), L"wb") != 0 ||
+        output == nullptr)
+    {
+        m_captureReadback->Unmap(0, nullptr);
+        ThrowIfFailed(E_FAIL);
+    }
+    fprintf(output, "P6\n%u %u\n255\n", m_width, m_height);
+    for (UINT y = 0; y < m_height; ++y)
+    {
+        const UINT8* row = pixels +
+            static_cast<size_t>(y) * m_captureFootprint.Footprint.RowPitch;
+        for (UINT x = 0; x < m_width; ++x)
+        {
+            const UINT8* rgba = row + static_cast<size_t>(x) * 4;
+            fwrite(rgba, 1, 3, output);
+        }
+    }
+    fclose(output);
+    const CD3DX12_RANGE writtenRange(0, 0);
+    m_captureReadback->Unmap(0, &writtenRange);
+}
