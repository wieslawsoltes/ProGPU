+static void WriteOracleFailure(const char* message)
+{
+    const DWORD captureLength = GetEnvironmentVariableW(
+        L"PROGPU_DIRECTX_ORACLE_OUTPUT", nullptr, 0);
+    if (captureLength <= 1)
+    {
+        return;
+    }
+    std::wstring capturePath(captureLength, L'\0');
+    const DWORD copied = GetEnvironmentVariableW(
+        L"PROGPU_DIRECTX_ORACLE_OUTPUT",
+        &capturePath[0],
+        captureLength);
+    if (copied == 0 || copied >= captureLength)
+    {
+        return;
+    }
+    capturePath.resize(copied);
+    capturePath.append(L".error.txt");
+    FILE* output = nullptr;
+    if (_wfopen_s(&output, capturePath.c_str(), L"wb") == 0 && output != nullptr)
+    {
+        fprintf(output, "%s\n", message);
+        fclose(output);
+    }
+}
