# Auto detect text files and perform LF normalization
* text=auto

# Unix entry points are invoked directly by CI on every host.
*.sh text eol=lf

# Reviewed Avalonia source patches must remain byte-stable when Git for Windows
# enables core.autocrlf, otherwise git apply sees CRLF patch context.
eng/avalonia/**/*.patch text eol=lf whitespace=-blank-at-eol
eng/directx-graphics-samples/*.patch text eol=lf whitespace=-blank-at-eol

# Dependency lock verification hashes the reviewed bytes on Windows as well.
eng/wgpu-dxc/Cargo.lock text eol=lf
# A unified patch retains leading-space blank context lines, including at its end.
eng/wgpu-hlsl/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof

# Original Windows metric receipt retains its captured bytes, including CRLF.
src/ProGPU.Tests/TestData/SourceDeviceLines/metrics.json -text

# Captured binary-glyph fixtures have immutable SHA-256 identities on every host.
# Do not rewrite their original LF bytes when core.autocrlf is enabled.
tests/Shared/BinaryGlyphOriginals.json -text
tests/Shared/BinaryGlyphCurveOriginals.json -text

# Preserve reviewed temporary diagnostic source bytes.
eng/diagnostics/arm64-scalar-runtime/** -text
