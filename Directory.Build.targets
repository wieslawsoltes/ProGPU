<Project>
  <PropertyGroup>
    <ProGpuXlibSourceRuntimeRoot Condition="'$(ProGpuXlibSourceRuntimeRoot)' == '' And Exists('$(MSBuildThisFileDirectory)artifacts/progpu-xlib/package')">$(MSBuildThisFileDirectory)artifacts/progpu-xlib/package</ProGpuXlibSourceRuntimeRoot>
    <ProGpuWgpuWindowsSourceRuntimeRoot Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' == '' And '$(ProGpuWgpuWindowsRuntimeRoot)' != ''">$(ProGpuWgpuWindowsRuntimeRoot)</ProGpuWgpuWindowsSourceRuntimeRoot>
    <ProGpuWgpuWindowsSourceRuntimeRoot Condition="'$(ProGpuWgpuWindowsSourceRuntimeRoot)' == '' And Exists('$(MSBuildThisFileDirectory)artifacts/progpu-wgpu-windows/package')">$(MSBuildThisFileDirectory)artifacts/progpu-wgpu-windows/package</ProGpuWgpuWindowsSourceRuntimeRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)src/ProGPU.Backend/buildTransitive/ProGPU.Backend.targets"
          Condition="'$(ProGpuXlibSourceRuntimeRoot)' != '' Or '$(ProGpuWgpuWindowsSourceRuntimeRoot)' != ''" />
  <Target Name="_ProGpuRemoveNetCoreWindowsBaseFacade"
          BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveTargetingPackAssets;ResolveLockFileReferences"
          Condition="'$(ProGpuUseWindowsBaseShim)' == 'true'">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.Filename)' == 'WindowsBase'
                            And '%(Reference.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(ReferencePath.Filename)' == 'WindowsBase'
                                And '%(ReferencePath.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)"
                                      Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'WindowsBase'
                                                 And '%(ReferencePathWithRefAssemblies.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'" />
    </ItemGroup>
  </Target>
</Project>
