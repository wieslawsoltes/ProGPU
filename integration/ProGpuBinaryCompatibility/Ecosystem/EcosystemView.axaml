<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
             xmlns:svgSkia="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:web="clr-namespace:WebScene;assembly=WebScene"
             xmlns:webSdk="clr-namespace:WebScene.Sdk.Avalonia;assembly=WebScene.Sdk.Avalonia"
             x:Class="ProGpuEcosystemCompatibility.EcosystemView">
  <Grid ColumnDefinitions="*,*"
        RowDefinitions="*,*">
    <svgSkia:Svg x:Name="SkiaSvgControl"
                 Width="64"
                 Height="64"
                 EnableCache="True" />
    <svg:Svg x:Name="AvaloniaSvgControl"
             Grid.Column="1"
             Width="64"
             Height="64" />
    <web:canvas x:Name="WebCanvas"
                Grid.Row="1"
                width="64"
                height="64" />
    <webSdk:WebSceneComponentHost x:Name="WebComponent"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  AutoMount="False" />
  </Grid>
</UserControl>
