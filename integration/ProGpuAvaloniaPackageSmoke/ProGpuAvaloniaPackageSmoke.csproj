<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>ProGpuAvaloniaPackageSmoke</AssemblyName>
    <RootNamespace>ProGpuAvaloniaPackageSmoke</RootNamespace>
    <ProGpuIntegrationPackageVersion Condition="'$(ProGpuIntegrationPackageVersion)' == ''">12.1.1-preview.57</ProGpuIntegrationPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"
                      Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter"
                      Version="12.1.1" />
    <PackageReference Include="ProGPU.Avalonia.Rendering"
                      Version="$(ProGpuIntegrationPackageVersion)" />
    <PackageReference Include="ProGPU.Avalonia.SilkNet"
                      Version="$(ProGpuIntegrationPackageVersion)" />
  </ItemGroup>
</Project>
